-- [[ LOGICAS VISUAIS E DE UPGRADE DO JOGO ]]
local function createOrUpdateHitboxes(scale)
    for _, model in ipairs(workspace:GetChildren()) do
        if model:IsA("Model") and model.Name:match("^CLIENT_BALL_%d+$") then
            local ball = model:FindFirstChild("Ball.001")
            if not ball then
                local ref = nil
                for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then ref = p break end end
                if ref then
                    ball = Instance.new("Part", model); ball.Name = "Ball.001"; ball.Shape = Enum.PartType.Ball
                    ball.Size = Vector3.new(2, 2, 2) * scale; ball.CFrame = ref.CFrame; ball.Anchored = true
                    ball.CanCollide = false; ball.Transparency = 0.7; ball.Material = Enum.Material.ForceField
                    ball.Color = Color3.fromRGB(0, 255, 255)
                end
            else
                ball.Size = Vector3.new(2, 2, 2) * scale
            end
        end
    end
end

UIS.JumpRequest:Connect(function()
    if _G.DirectionalJump and humanoid and hrp then
        task.defer(function()
            task.wait(0.03)
            local dir = Vector3.new(Camera.CFrame.LookVector.X, 0, Camera.CFrame.LookVector.Z)
            if dir.Magnitude > 0 then
                hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir.Unit)
                humanoid.AutoRotate = false
            end
        end)
    elseif humanoid then humanoid.AutoRotate = true end
end)

local function OptimizeGraphics()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsA("MeshPart") then
            obj.Material = Enum.Material.SmoothPlastic
        elseif obj:IsA("Decal") or obj:IsA("Texture") then
            obj:Destroy()
        end
    end
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("ColorCorrectionEffect") or effect:IsA("SunRaysEffect") then
            effect.Enabled = false
        end
    end
end

