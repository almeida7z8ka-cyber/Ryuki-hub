    }
}

local RANK_VALUES = {
    ["bronze i"] = 1,
    ["bronze ii"] = 2,
    ["bronze iii"] = 3,
    ["silver i"] = 4,
    ["silver ii"] = 5,
    ["silver iii"] = 6,
    ["gold i"] = 7,
    ["gold ii"] = 8,
    ["gold iii"] = 9,
    ["diamond i"] = 10,
    ["diamond ii"] = 11,
    ["diamond iii"] = 12
}

local function normalizeRank(text)
    text = string.lower(text or "")
    text = text:gsub("^%s+", "")
    text = text:gsub("%s+$", "")
    text = text:gsub("%s+", " ")
    return text
end

local function getPlayerRank()
    local foundRank = nil

    -- 1. Procura nos leaderstats do jogador (o lugar mais comum)
    local leaderstats = Player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, child in ipairs(leaderstats:GetChildren()) do
            -- Aceita "Rank", "SeasonRank", "Tier", "Liga" ou "Division"
            if child:IsA("StringValue") then
                foundRank = normalizeRank(child.Value)
                if RANK_VALUES[foundRank] then
                    print("[Ryuky] Rank de leaderstats: " .. foundRank)
                    return foundRank
                end
            end
        end
    end

    -- 2. Procura por qualquer StringValue no jogador que contenha um rank válido
    for _, child in ipairs(Player:GetChildren()) do
        if child:IsA("StringValue") then
            local val = normalizeRank(child.Value)
            if RANK_VALUES[val] then
                print("[Ryuky] Rank do jogador: " .. val)
                return val
            end
        end
    end

    -- 3. Último recurso: debug completo para você me contar o que achou
    warn("[Ryuky] Estrutura do jogador não mapeada. Envie o log abaixo:")
    if leaderstats then
        for _, c in ipairs(leaderstats:GetChildren()) do
            warn("leaderstats." .. c.Name .. " = " .. tostring(c.Value))
        end
    else
        warn("leaderstats não encontrado.")
    end
    for _, c in ipairs(Player:GetChildren()) do
        warn("Player." .. c.Name .. " (" .. c.ClassName .. ")")
    end
    return nil
end

local function getBestReward(rewardType)
    local playerRank = getPlayerRank()
    if not playerRank then
        print("[Ryuky] Rank não encontrado! Usando recompensa básica (Bronze I)")
        print("[Ryuky] Dica: Ative o toggle e verifique o console (F9) para ver o DEBUG")
        return RANK_REWARDS[rewardType][1] or 1
    end
    
    local rankNumber = RANK_VALUES[playerRank]
    if not rankNumber then
        print("[Ryuky] Rank '" .. playerRank .. "' não está na tabela! Usando recompensa básica")
        return RANK_REWARDS[rewardType][1] or 1
    end
    
    local bestReward = nil
    local rewards = RANK_REWARDS[rewardType]
    
    for requiredRank, invokeValue in pairs(rewards) do
        if rankNumber >= requiredRank then
            if not bestReward or invokeValue > bestReward then
                bestReward = invokeValue
            end
        end
    end
    
    if bestReward then
        print(string.format("[Ryuky] Rank %s (nível %d) detectado! Recompensa: %d", playerRank, rankNumber, bestReward))
        return bestReward
    else
        return rewards[1] or 1
    end
end

