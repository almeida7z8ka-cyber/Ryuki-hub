-- [[ SISTEMA DE DETECÇÃO DE RANK - VERSÃO ROBUSTA ]]
local RANK_REWARDS = {
    LUCKY = {
        [1] = 1,
        [7] = 7,
        [12] = 11
    },
    HABILIDADE = {
        [1] = 4,
